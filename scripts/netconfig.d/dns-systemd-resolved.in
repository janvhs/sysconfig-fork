##

unset POSIXLY_CORRECT ; set +o posix # we are using non-posix bash features

# The environment variable ROOT indicates the root of the system to be
# managed by SuSEconfig when that root is not '/'
r="$ROOT"

. "$r@libexec_netconfigdir@/functions.netconfig" || exit 1

PROGNAME="${0##*/}"
if test "$UID" != "0" -a "$USER" != root -a -z "$ROOT" ; then
    warn "You must be root to start $0." >&2
    exit 1
fi

resolvectl="/usr/bin/resolvectl"
SYSFSDIR="/sys/class/net"
STATEDIR="/run/netconfig"
debug "$PROGNAME module called"

. "$r/etc/sysconfig/network/config"

unset DNS_SEARCHLIST ${!DNS_SEARCHLIST_*}
unset DNS_SERVERS ${!DNS_SERVERS_*}

# *********************
# FUNCTIONS
# *********************

function list_find()
{
    local item want="$1" ; shift
    for item in "$@" ; do
        [ X"$want" = X"$item" ] && return 0
    done
    return 1
}
function list_uniq()
{
    local item list=()
    for item in "$@" ; do
        list_find "$item" "${list[@]}" && continue
        list+=("$item")
    done
    echo "${list[@]}"
}

function manage_systemd_resolved()
{
    local iflist=("$@")

    debug "exec manage_systemd_resolved: ${iflist[@]}"
    for ((i=0;i<${#iflist[@]};i++)) {
        local ifname="${iflist[$i]}"
        local ifservers=()
        local ifdomains=()
        for ((s=0;s<3;s++)) ; do
            local server_var="DNS_SERVERS_${i}_${s}"
            local domain_var="DNS_SEARCHLIST_${i}_${s}"
            ifservers=($(list_uniq "${ifservers[@]}" ${!server_var}))
            ifdomains=($(list_uniq "${ifdomains[@]}" ${!domain_var}))
        done
        if test ${#ifservers[@]} -gt 0 ; then
            debug "     resolvectl dns $ifname ${ifservers[@]}"
            $resolvectl dns "$ifname" "${ifservers[@]}"
        else
            # all leases removed
            debug "     resolvectl dns $ifname ''"
            $resolvectl dns "$ifname" ""
        fi
        if test ${#ifdomains[@]} -gt 0 ; then
            debug "     resolvectl domain $ifname ${ifdomains[@]}"
            $resolvectl domain "$ifname" "${ifdomains[@]}"
        else
            debug "     resolvectl domain $ifname ''"
            $resolvectl domain "$ifname" ""
        fi
    }
    debug "exit manage_systemd_resolved: ${iflist[@]}"
    return 0
}

function get_dns_settings()
{
    local ifn="$1" ; shift
    local cfg="$1" ; shift
    local ifname="$1" ; shift
    test "x$ifn" != x -a "x$cfg" != x -a "x$ifname" != x || return 1

    local SERVICE DNSSEARCH DNSDOMAIN DNSSERVERS
    local var idx DNS_SEARCHLIST DNS_SERVERS

    debug "exec get_dns_settings: $pfx $cfg for $ifname"

    get_variable "SERVICE" "$cfg"
    idx=`get_ranking_idx "$SERVICE" "$@"`
    debug "     get_dns_settings: service '$SERVICE' => rank '$idx'"

    # Interface specific search list
    var="DNS_SEARCHLIST_${ifn}_${idx}"
    DNS_SEARCHLIST=(${!var})
    get_variable "DNSSEARCH" "$cfg"
    if [ "x$DNSSEARCH" != "x" ]; then
        DNS_SEARCHLIST=($(list_uniq "${DNS_SEARCHLIST[@]}" "$DNSSEARCH"))
    else
        get_variable "DNSDOMAIN" "$cfg"
        if [ "x$DNSDOMAIN" != "x" ]; then
            DNS_SEARCHLIST=($(list_uniq "${DNS_SEARCHLIST[@]}" "$DNSDOMAIN"))
        else
            local H=$HOSTNAME
            local HOSTNAME
            get_variable "HOSTNAME" "$cfg"
            HOSTNAME="${HOSTNAME%.}"
            if [ "x$HOSTNAME" != "x" -a "x${HOSTNAME#*.}" != "x" \
                 -a "${HOSTNAME#*.}" != "${HOSTNAME}" ] ; then
                DNS_SEARCHLIST=($(list_uniq "${DNS_SEARCHLIST[@]}" "${HOSTNAME#*.}"))
            fi
            HOSTNAME=$H
        fi
    fi
    unset DNSSEARCH DNSDOMAIN
    eval "${var}='${DNS_SEARCHLIST[@]}'"
    debug "     get_dns_settings: ${var}='${!var}'"

    # Interface specific server list
    var="DNS_SERVERS_${ifn}_${idx}"
    DNS_SERVERS=(${!var})
    get_variable "DNSSERVERS" "$cfg"
    if [ "x$DNSSERVERS" != "x" ]; then
        DNS_SERVERS=($(list_uniq "${DNS_SERVERS[@]}" "$DNSSERVERS"))
    fi
    unset DNSSERVERS
    eval "${var}='${DNS_SERVERS[@]}'"
    debug "     get_dns_settings: ${var}='${!var}'"

    debug "exit get_dns_settings: $pfx $cfg for $ifname"
    return 0
}

function manage_interfaceconfig()
{
    local ifvar="$1" ; shift
    local ifdir="$1" ; shift
    local ifname="${ifdir##*/}"
    test "x$ifvar" != x -a "x$ifdir" != x || return 1
    test "x$ifname" != x -a -d "$ifdir"   || return 1

    # do not send per interface settings for loopback
    test "x$ifname" != xlo                || return 0

    local iflist=(${!ifvar})
    # just in case, handle each interface once only
    list_find "$ifname" "${iflist[@]}" && return 0

    debug "exec manage_interfaceconfig: $ifdir for $ifname"
    for cfg in `ls -X -r "$ifdir/" 2>/dev/null`; do
        get_dns_settings ${#iflist[@]} "$ifdir/$cfg" "$ifname" "$@" || return 1
    done
    iflist+=("$ifname")
    eval "${ifvar}='${iflist[@]}'"
    debug "exit manage_interfaceconfig: $ifdir for $ifname"
    return 0
}

function applicable_network_service()
{
    local Id=`systemctl --no-pager -p Id show network.service 2>/dev/null`
    local service=${Id#Id=}

    service=${service%.service}
    if test "X$service" = "X" ; then
        debug "Systemd did not reported any enabled network service"
	service=`find_current_service "network.service" 2>/dev/null`
        service=${service%.service}
        debug "Using '$service' as network service"
    fi

    case ${service} in
      # with wicked as network.service, wicked and other services are
      # passing per-service and per-interface settings to netconfig.
      wicked)           return 0 ;;

      # NetworkManager collects the settings from it's plugins and is
      # passing the already merged settings to netconfig, processed by
      # the dns-resolver (/etc/resolv.conf) module.
      # It also passes the per-interface settings to systemd-resolved.
      NetworkManager|*) return 1 ;;
    esac
}

# *********************
# EXECUTION STARTS HERE
# *********************

[ "x$NETCONFIG_DNS_FORWARDER" != "xsystemd-resolved" ]       && exit 0
applicable_network_service                                   || exit 0

test -x $resolvectl                                          || exit 1
systemctl is-enabled -q systemd-resolved.service &>/dev/null || exit 1

# just for the case we need the original value...
_NETCONFIG_DNS_RANKING="$NETCONFIG_DNS_RANKING"
case "$_NETCONFIG_DNS_RANKING" in
  auto) _NETCONFIG_DNS_RANKING="$NETCONFIG_DNS_RANKING_DEFAULT" ;;
  none) _NETCONFIG_DNS_RANKING=""                               ;;
esac

# just for the case we need the original value...
_NETCONFIG_DNS_POLICY=`netconfig_policy "$NETCONFIG_DNS_POLICY" dns`
if [ "x$_NETCONFIG_DNS_POLICY" = "x" ]; then
    #
    # empty policy means do not touch anything.
    # successful exit.
    #
    exit 0;
fi

_g=1
managed_interfaces=""
# disable filename glob expansion if needed
shopt -o -q noglob || _g=0
shopt -o -s noglob
for POL in $_NETCONFIG_DNS_POLICY; do
    shopt -o -u noglob
    case "$POL" in
    (NetworkManager|STATIC|STATIC_FALLBACK)
        # NetworkManager sends per interface settings to systemd-resolved by default,
        # static settings are handled by the dns-resolver netconfig module.
    ;;
    (*)
        # Get current set of per-interface settings 
        debug "Other: $POL"
        for IFDIR in $ROOT$STATEDIR/$POL; do
            test -d "$IFDIR" -a \
                 -d "$SYSFSDIR/${IFDIR##*/}" || continue
            # proceed every interface we find with this match
            manage_interfaceconfig managed_interfaces "$IFDIR" "$_NETCONFIG_DNS_RANKING"
        done
    ;;
    esac
done
if [ $_g -eq 0 ] ; then
    shopt -o -u noglob
else
    shopt -o -s noglob
fi

manage_systemd_resolved $managed_interfaces || exit 1

exit 0
