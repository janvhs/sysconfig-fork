##

unset POSIXLY_CORRECT ; set +o posix # we are using non-posix bash features

# The environment variable ROOT indicates the root of the system to be
# managed by SuSEconfig when that root is not '/'
r="$ROOT"

. "$r@libexec_netconfigdir@/functions.netconfig" || exit 1

PROGNAME="${0##*/}"
if test "$UID" != "0" -a "$USER" != root -a -z "$ROOT" ; then
    warn "You must be root to start $0." >&2
    exit 1
fi

resolvectl="/usr/bin/resolvectl"
SYSFSDIR="/sys/class/net"
STATEDIR="/run/netconfig"
debug "$PROGNAME module called"

. "$r/etc/sysconfig/network/config"

unset DNS_SEARCHLIST ${!DNS_SEARCHLIST_*}
unset DNS_SERVERS ${!DNS_SERVERS_*}

declare -a MANAGED_INTERFACES

# *********************
# FUNCTIONS
# *********************

function list_find()
{
    local needle="$1" ; shift
    local haystack=("$@")

    [ 0 -eq "${#haystack[@]}" ] && return 1

    for i in $(seq 0 "$(("${#haystack[@]}" - 1))"); do
        if [ "$needle" = "${haystack["$i"]}" ] ; then
            printf "%d\n" "$i"
            return 0
        fi
    done

    return 1
}

function interface_get_index()
{
    local ifname="$1"
    test -n "$ifname" || return 1

    test -n "$2" || retrun 1
    declare -n idx="$2"

    debug "exec interface_get_index: $ifname"

    if ! idx="$(list_find "$ifname" "${MANAGED_INTERFACES[@]}")" ; then
        return 1
    fi

    debug "exit interface_get_index: $ifname"

    return 0
}

function interface_manage() {
    local ifname="$1"
    test -n "$ifname" || return 1

    test -n "$2" || retrun 1
    declare -n idx="$2"

    debug "exec interface_manage: $ifname"

    idx="${#MANAGED_INTERFACES[@]}"
    MANAGED_INTERFACES+=("$ifname")

    debug "exit interface_manage: $ifname"

    return 0
}

function dns_servers_add()
{
    local ifname="${1}" ; shift
    local ranking="${1}" ; shift
    local servers=("$@")

    test -n "$ifname" -a \
         -n "$ranking" || return 1

    debug "exec dns_servers_add: $ifname $ranking"

    local ifindex=
    if ! interface_get_index "$ifname" ifindex; then
        interface_manage "$ifname" ifindex
    fi

    [ -n "$ifindex" ] || return 1

    test 0 -ne "${#servers[@]}" || return 0

    eval "DNS_SERVERS_${ifindex}_${ranking}+=(\"\${servers[@]}\")"

    debug "exit dns_servers_add: $ifname $ranking"

    return 0
}

function dns_searchlist_add()
{
    local ifname="${1}" ; shift
    local ranking="${1}" ; shift
    local searchlist=("$@")

    test -n "$ifname" -a \
         -n "$ranking" || return 1

    debug "exec dns_searchlist_add: $ifname $ranking"

    local ifindex=
    if ! interface_get_index "$ifname" ifindex; then
        interface_manage "$ifname" ifindex
    fi

    [ -n "$ifindex" ] || return 1

    test 0 -ne "${#searchlist[@]}" || return 0

    eval "DNS_SEARCHLIST_${ifindex}_${ranking}+=(\"\${searchlist[@]}\")"

    debug "exit dns_searchlist_add: $ifname $ranking"

    return 0
}

function dns_servers_get()
{
    local ifname="${1}"
    local ranking="${2}"
    local varname="${3}"

    test -n "$ifname" -a \
         -n "$ranking" -a \
         -n "$varname" || return 1

    debug "exec dns_servers_get: $ifname $ranking"

    local ifindex=
    interface_get_index "$ifname" ifindex || return 1
    [ -n "$ifindex" ] || return 1


    local listname="DNS_SERVERS_${ifindex}_${ranking}"
    eval "[ -n \"\${${listname}+x}\" ] || declare -g -a ${listname}"
    declare -n ranked_servers="$listname"

    declare -n servers_out="$varname"
    if [ 0 -ne "${#ranked_servers[@]}" ] ; then
        servers_out+=("${ranked_servers[@]}")
    fi

    debug "exec dns_servers_get: $ifname $ranking"

    return 0
}

function dns_searchlist_get()
{
    local ifname="${1}"
    local ranking="${2}"
    local varname="${3}"

    test -n "$ifname" -a \
         -n "$ranking" -a \
         -n "$varname" || return 1

    debug "exec dns_searchlist_get: $ifname $ranking"

    local ifindex=
    interface_get_index "$ifname" ifindex || return 1
    [ -n "$ifindex" ] || return 1


    local listname="DNS_SEARCHLIST_${ifindex}_${ranking}"
    eval "[ -n \"\${${listname}+x}\" ] || declare -g -a ${listname}"
    declare -n ranked_searchlist="$listname"

    declare -n searchlist_out="$varname"
    if [ 0 -ne "${#ranked_searchlist[@]}" ] ; then
        searchlist_out+=("${ranked_searchlist[@]}")
    fi

    debug "exec dns_searchlist_get: $ifname $ranking"

    return 0
}

function manage_systemd_resolved()
{
    debug "exec manage_systemd_resolved"

    for ifname in "${MANAGED_INTERFACES[@]}" ; do
        declare -a ifservers
        dns_servers_get "$ifname" 0 ifservers
        dns_servers_get "$ifname" 1 ifservers
        dns_servers_get "$ifname" 2 ifservers

        if test ${#ifservers[@]} -gt 0 ; then
            debug "     resolvectl dns $ifname ${ifservers[@]}"
            $resolvectl dns "$ifname" "${ifservers[@]}"
        else
            # all leases removed
            debug "     resolvectl dns $ifname ''"
            $resolvectl dns "$ifname" ""
        fi
        unset ifservers

        declare -a ifdomains
        dns_searchlist_get "$ifname" 0 ifdomains
        dns_searchlist_get "$ifname" 1 ifdomains
        dns_searchlist_get "$ifname" 2 ifdomains

        if test ${#ifdomains[@]} -gt 0 ; then
            debug "     resolvectl domain $ifname ${ifdomains[@]}"
            $resolvectl domain "$ifname" "${ifdomains[@]}"
        else
            debug "     resolvectl domain $ifname ''"
            $resolvectl domain "$ifname" ""
        fi
        unset ifdomains
    done

    debug "exit manage_systemd_resolved"
    return 0
}

function get_dns_settings()
{
    local cfg="$1" ; shift
    local ifname="$1" ; shift
    test -n "$cfg" -a \
         -n "$ifname" || return 0

    local SERVICE DNSSEARCH DNSDOMAIN DNSSERVERS
    local idx DNS_SEARCHLIST DNS_SERVERS

    debug "exec get_dns_settings: $cfg for $ifname"

    get_variable "SERVICE" "$cfg"
    idx="$(get_ranking_idx "$SERVICE" "$@")"
    debug "     get_dns_settings: service '$SERVICE' => rank '$idx'"

    get_variable "DNSSEARCH" "$cfg"
    if [ -n "$DNSSEARCH" ]; then
        read -r -a DNS_SEARCHLIST <<< "$DNSSEARCH"
    else
        get_variable "DNSDOMAIN" "$cfg"
        if [ -n "$DNSDOMAIN" ]; then
            read -r -a DNS_SEARCHLIST <<< "$DNSDOMAIN"
        else
            # FIXME: Why only segment y xxx.yyy. ??
            local H=$HOSTNAME
            local HOSTNAME
            get_variable "HOSTNAME" "$cfg"
            HOSTNAME="${HOSTNAME%.}"
            if [ -n "$HOSTNAME" -a -n "${HOSTNAME#*.}" \
                 -a "${HOSTNAME#*.}" != "${HOSTNAME}" ] ; then
                read -r -a DNS_SEARCHLIST <<< "${HOSTNAME#*.}"
            fi
            HOSTNAME=$H
        fi
    fi
    unset DNSSEARCH DNSDOMAIN
    dns_searchlist_add "$ifname" "$idx" "${DNS_SEARCHLIST[@]}"

    # Interface specific server list
    get_variable "DNSSERVERS" "$cfg"
    if [ -n "$DNSSERVERS" ]; then
        read -r -a DNS_SERVERS <<< "$DNSSERVERS"
    fi
    unset DNSSERVERS
    dns_servers_add "$ifname" "$idx" "${DNS_SERVERS[@]}"

    debug "exit get_dns_settings: $cfg for $ifname"

    return 0
}

function applicable_network_service()
{
    local id=
    id="$(systemctl --no-pager -p Id show network.service 2>/dev/null)"
    local service=${id#Id=}

    service=${service%.service}
    if test -z "$service" ; then
        debug "Systemd did not reported any enabled network service"
        service="$(find_current_service "network.service" 2>/dev/null)"
        service=${service%.service}
        debug "Using '$service' as network service"
    fi

    case ${service} in
      # with wicked as network.service, wicked and other services are
      # passing per-service and per-interface settings to netconfig.
      wicked)           return 0 ;;

      # NetworkManager collects the settings from it's plugins and is
      # passing the already merged settings to netconfig, processed by
      # the dns-resolver (/etc/resolv.conf) module.
      # It also passes the per-interface settings to systemd-resolved.
      NetworkManager|*) return 1 ;;
    esac
}

function handle_static_policy()
{
    local searchlist
    read -r -a searchlist <<< "${1:-}"

    local servers
    read -r -a servers <<< "${2:-}"

    debug "exec handle_static_policy"

    for ifdir in "${ROOT}${STATEDIR}/"*; do
        local ifname="${ifdir##*/}"

        test "$ifname" != "lo" -a \
             -d "$ifdir" -a \
             -d "$SYSFSDIR/$ifname" || continue

        dns_servers_add "$ifname" 1 "${servers[@]}"
        dns_searchlist_add "$ifname" 1 "${searchlist[@]}"
    done

    debug "exit handle_static_policy"
}

function handle_normal_policy()
{
    local policy="${1:-}" ; shift
    test -n "$policy" || return 0

    debug "exec handle_normal_policy: $policy"

    for ifdir in "${ROOT}${STATEDIR}/"$policy; do
        local ifname="${ifdir##*/}"

        test "$ifname" != "lo" -a \
             -d "$ifdir" -a \
             -d "$SYSFSDIR/$ifname" || continue

        for cfg in "$ifdir/"* ; do
            test -e "$cfg" || break

            get_dns_settings "$cfg" "$ifname" "$@"
        done
    done


    debug "exit handle_normal_policy: $policy"
}

# *********************
# EXECUTION STARTS HERE
# *********************

[ "$NETCONFIG_DNS_FORWARDER" != "systemd-resolved" ] && exit 0
applicable_network_service                           || exit 0

if ! [ -e "$resolvectl" ] ; then
    debug "$resolvectl does not exist"
    exit 1
fi

if ! [ -x "$resolvectl" ] ; then
    debug "$resolvectl is not executable"
    exit 1
fi

if ! systemctl -q is-enabled systemd-resolved.service ; then
    debug 'The service "systemd-resolved.service" is not enabled'
    exit 1
fi

# just for the case we need the original value...
_NETCONFIG_DNS_RANKING="$NETCONFIG_DNS_RANKING"
case "$_NETCONFIG_DNS_RANKING" in
  auto) _NETCONFIG_DNS_RANKING="$NETCONFIG_DNS_RANKING_DEFAULT" ;;
  none) _NETCONFIG_DNS_RANKING=""                               ;;
esac

# TODO: Move checks to after this, so it wouldn't throw errors when there is an empty policy?
# just for the case we need the original value...
_NETCONFIG_DNS_POLICY="$(netconfig_policy "$NETCONFIG_DNS_POLICY" dns)"
if [ -z "$_NETCONFIG_DNS_POLICY" ]; then
    #
    # empty policy means do not touch anything.
    # successful exit.
    #
    exit 0;
fi

_g=1
# disable filename glob expansion if needed
shopt -o -q noglob || _g=0
shopt -o -s noglob
for POL in $_NETCONFIG_DNS_POLICY; do
    shopt -o -u noglob
    case "$POL" in
    (NetworkManager|STATIC_FALLBACK)
        # NetworkManager sends per interface settings to systemd-resolved by default,
        # static settings are handled by the dns-resolver netconfig module.
    ;;
    (STATIC)
        debug "Keep Static"
        handle_static_policy \
            "${NETCONFIG_DNS_STATIC_SEARCHLIST}" \
            "${NETCONFIG_DNS_STATIC_SERVERS}"
    ;;
    (*)
        # Get current set of per-interface settings
        debug "Other: $POL"
        handle_normal_policy "$POL" "$_NETCONFIG_DNS_RANKING"
    ;;
    esac
done
if [ $_g -eq 0 ] ; then
    shopt -o -u noglob
else
    shopt -o -s noglob
fi

manage_systemd_resolved || exit 1

exit 0
